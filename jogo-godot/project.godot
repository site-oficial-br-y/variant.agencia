; Projeto Godot 4.3 — Capota Brasil (protótipo segway com ragdoll da própria arte)
config_version=5

[application]
config/name="Bicho Ehn"
config/icon="res://assets/ui/icone.png"
run/main_scene="res://levels/Abertura.tscn"
config/features=PackedStringArray("4.3")
boot_splash/bg_color=Color(0.043, 0.024, 0.071, 1)
boot_splash/show_image=false

[autoload]
Game="*res://autoload/Game.gd"
Midia="*res://autoload/Midia.gd"
Playtest="*res://autoload/Playtest.gd"
Audio="*res://autoload/Audio.gd"
Online="*res://autoload/Online.gd"
Conta="*res://autoload/Conta.gd"

[physics]
2d/default_gravity=980.0
common/physics_ticks_per_second=180

[rendering]
textures/canvas_textures/default_texture_filter=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/LilitaOne.woff2"

[input_devices]

pointing/emulate_touch_from_mouse=true
